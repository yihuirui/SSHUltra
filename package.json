{
  "name": "sshultra",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "A focused SSH workspace for everyday operations",
  "author": "SSHUltra contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/third-party-notices.cjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test --test-reporter=tap tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:reliability-ui": "node tests/reliability-ui.cjs",
    "package:mac": "npm run build && node scripts/package-mac.cjs",
    "test:workflows-ui": "node tests/workflows-ui.cjs",
    "package:mac:x64": "npm run build && node scripts/package-mac.cjs --arch=x64",
    "package:mac:arm64": "npm run build && node scripts/package-mac.cjs --arch=arm64",
    "test:fixes-ui": "node tests/review-fixes-ui.cjs",
    "test:password-ui": "node tests/password-ui.cjs",
    "test:imports-ui": "node tests/imports-ui.cjs"
  },
  "build": {
    "appId": "io.github.yihuirui.sshultra",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "SSHUltra-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/electron/LICENSE",
        "to": "Electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "productName": "SSHUltra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "templates/*.xlsx",
      "templates/*.csv",
      "templates/*.txt",
      "templates/*.md"
    ],
    "asarUnpack": [
      "node_modules/ssh2/lib/protocol/crypto/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
